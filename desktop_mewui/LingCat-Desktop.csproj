<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LingCat_Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.ico" />
    <EmbeddedResource Include="icon.png" />

    <PackageReference Include="Aprillz.MewUI" Version="0.22.1" />
    <PackageReference Include="Aprillz.MewUI.Linux" Version="0.22.1" />
    <PackageReference Include="Aprillz.MewUI.MacOS" Version="0.22.1" />
    <PackageReference Include="Aprillz.MewUI.Windows" Version="0.22.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\desktop_client_protocol\LingCat.ClientProtocol.csproj" />
  </ItemGroup>

</Project>
