{
    "name": "lingcat",
    "version": "0.0.0",
    "workspaces": [
        "./server",
        "./shared",
        "./protocol",
        "./client-protocol",
        "./client",
        "./test"
    ],
    "scripts": {
        "server": "npx tsx ./server/main.ts",
        "test": "node ./test/main.js",
        "generate-proto": "npx pbjs -t static-module -w esm -o ./protocol/lingcat-proto.js --dts ./protocol/*.proto"
    },
    "devDependencies": {
        "protobufjs-cli": "^2.4.2"
    }
}
