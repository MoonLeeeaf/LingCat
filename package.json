{
    "name": "lingcat",
    "version": "0.0.0",
    "workspaces": [
        "./server",
        "./protocol",
        "./client_protocol",
        "./client",
        "./test",
        "./shared",
        "./mdui_patched"
    ],
    "scripts": {
        "start": "npm run build-client && npm run server",
        "server": "npx tsx ./server/main.ts",
        "test": "node ./test/main.js",
        "build-client": "cd client && npm run build",
        "build-android-client": "cd android_client && sh gradlew assembleDebug",
        "generate-proto": "npx pbjs -t static-module -w esm -o ./protocol/lingcat-proto.js -d ./protocol/classes.proto ./protocol/methods.proto",
        "generate-proto-android": "protoc -I=./protocol --java_out=./android/app/src/main/java/ ./protocol/*.proto",
        "typecheck": "tsc -p client/tsconfig.json --noEmit"
    },
    "devDependencies": {
        "protobufjs-cli": "^2.4.2",
        "typescript": "~5.6.3"
    }
}
