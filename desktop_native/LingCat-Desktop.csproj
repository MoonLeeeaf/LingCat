<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LingCat_Desktop</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <MewUIDevTools>true</MewUIDevTools>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/*" />

    <PackageReference Include="Aprillz.MewUI" Version="0.22.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="NotificationIcon.NET" Version="1.2.8" />
    <PackageReference Include="Notify.NET" Version="1.1.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />

    <ProjectReference Include="..\client_protocol_csharp\LingCat-ClientProtocol.csproj" />
    <ProjectReference Include="..\mewui_material\src\MewUI.Material\MewUI.Material.csproj" />
  </ItemGroup>

</Project>
